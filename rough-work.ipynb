    "    Yim = Y.detach().cpu().numpy().squeeze().transpose(1, 2, 0)\n",
    "    Xim = (Xim - Xim.min()) / (Xim.max() - Xim.min())\n",
    "    Yim = (Yim - Yim.min()) / (Yim.max() - Yim.min())\n",
    "    #cv2.imshow(\"X\", Xim)\n",
    "    #cv2.imshow(\"Y\", Yim)\n",
    "    #cv2.waitKey()\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    print(\"high2low_test()-------\")\n",
    "    high2low_test()\n",
    "    print(\"discriminator_test()-------\")\n",
    "    discriminator_test()\n",
    "    print(\"finished.\")"
